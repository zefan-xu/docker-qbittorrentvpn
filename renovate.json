{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "ignorePaths": [
    "docker-compose.yml"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Keep Docker image references immutable",
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    },
    {
      "description": "Keep GitHub Actions references immutable",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "qBittorrent static-build bumps update both arch asset checksums and need review; libtorrent 2.1 resume data is not safely downgradable",
      "matchPackageNames": [
        "userdocs/qbittorrent-nox-static"
      ],
      "groupName": "userdocs/qbittorrent-nox-static",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update s6-overlay version in the Dockerfile",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+ARG S6_OVERLAY_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update qBittorrent static build tag and the matching per-arch asset SHA-256",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>userdocs/qbittorrent-nox-static/x86_64-qbittorrent-nox) packageName=(?<packageName>userdocs/qbittorrent-nox-static)\\s+ARG QBITTORRENT_NOX_RELEASE=(?<currentValue>\\S+)\\s+ARG QBITTORRENT_NOX_SHA256_AMD64=(?<currentDigest>[a-f0-9]+)",
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>userdocs/qbittorrent-nox-static/aarch64-qbittorrent-nox) packageName=(?<packageName>userdocs/qbittorrent-nox-static)\\s+ARG QBITTORRENT_NOX_RELEASE_ARM64=(?<currentValue>\\S+)\\s+ARG QBITTORRENT_NOX_SHA256_ARM64=(?<currentDigest>[a-f0-9]+)"
      ],
      "versioningTemplate": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v(?<compatibility>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update selected Ubuntu package pins in the Dockerfile",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=deb depName=(?<depName>\\S+) suite=(?<suite>\\S+) components=(?<components>\\S+) binaryArch=(?<binaryArch>\\S+)\\s+ARG \\S+_VERSION=(?<currentValue>\\S+)"
      ],
      "registryUrlTemplate": "https://archive.ubuntu.com/ubuntu?suite={{{suite}}}&components={{{components}}}&binaryArch={{{binaryArch}}}",
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "Update actionlint installed in CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+go install github\\.com/rhysd/actionlint/cmd/actionlint@(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update pinned Docker images used inside GitHub Actions run steps",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n[ \\t]+docker run .*?ubuntu:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "{{{versioning}}}"
    }
  ]
}
