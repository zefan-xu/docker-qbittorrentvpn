#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/run/qbtvpn
STATE_FILE=${STATE_DIR}/state.env
QBT_CONF=/config/qBittorrent/config/qBittorrent.conf
QBT_DEFAULT_CONF=/defaults/qBittorrent.conf
QBT_WEBUI_PORT=8080
QBT_TORRENT_PORT=8999

log() {
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2"
}

die() {
  log ERROR "$1"
  exit 1
}

trim() {
  local value=${1:-}
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

lower() {
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]'
}

normalize_bool() {
  local name=$1
  local value
  value=$(lower "$(trim "${2:-}")")
  case "$value" in
    1|true|yes|y|on) printf 'yes' ;;
    0|false|no|n|off) printf 'no' ;;
    *) die "${name} must be one of yes/no/true/false/1/0, got '${2:-}'" ;;
  esac
}

is_ipv4() {
  [[ ${1:-} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && ipcalc-ng -4 -c "$1" >/dev/null 2>&1
}

validate_ipv4_cidr() {
  local cidr=$1
  [[ "$cidr" == */* ]] || return 1
  ipcalc-ng -4 -c "$cidr" >/dev/null 2>&1
}

split_csv() {
  local value=${1:-}
  local item
  local -a out=()
  local -a raw_items=()
  IFS=',' read -r -a raw_items <<< "$value"
  for item in "${raw_items[@]}"; do
    item=$(trim "$item")
    [[ -n "$item" ]] && out+=("$item")
  done
  printf '%s\n' "${out[@]}"
}

shell_quote() {
  printf '%q' "$1"
}

write_state_var() {
  local name=$1
  local value=$2
  printf 'export %s=%s\n' "$name" "$(shell_quote "$value")" >> "$STATE_FILE"
}

load_state() {
  [[ -f "$STATE_FILE" ]] || die "State file ${STATE_FILE} is missing"
  # shellcheck source=/dev/null
  source "$STATE_FILE"
}

detect_docker_network() {
  DOCKER_IFACE=$(ip -4 route show default | awk '{print $5; exit}')
  DOCKER_GATEWAY=$(ip -4 route show default | awk '{print $3; exit}')
  [[ -n "${DOCKER_IFACE:-}" ]] || die "Unable to detect Docker network interface"
  [[ -n "${DOCKER_GATEWAY:-}" ]] || die "Unable to detect Docker default gateway"
  DOCKER_CIDR=$(ip -4 route show dev "$DOCKER_IFACE" scope link | awk '$1 != "default" {print $1; exit}')
  [[ -n "${DOCKER_CIDR:-}" ]] || die "Unable to detect Docker network CIDR"
}

set_qbt_config_value() {
  local section=$1
  local key=$2
  local value=$3
  local file=${4:-$QBT_CONF}
  local tmp
  tmp=$(mktemp)
  if [[ -f "$file" ]]; then
    awk -v prefix="${key}=" 'index($0, prefix) != 1 { print }' "$file" > "$tmp"
  fi
  printf '\n[%s]\n%s=%s\n' "$section" "$key" "$value" >> "$tmp"
  mv "$tmp" "$file"
}
